{
  "name": "palt-typesetting",
  "version": "0.10.0",
  "description": "Typesetting Library for Proportional Spacing",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "types/**/*",
    "dist/**/*",
    "bundle/**/*"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yamatoiizuka/palt-typesetting.git"
  },
  "scripts": {
    "clean": "rm -rf ./dist && rm -rf ./bundle",
    "copy:css": "mkdir ./dist && cp -R ./src/*.css ./dist/",
    "prebuild": "npm run clean && npm run copy:css",
    "bundle:css": "mkdir ./bundle && cleancss -o ./bundle/typesetter.min.css ./src/*.css",
    "bundle": "npm run bundle:css && webpack",
    "build": "node ./scripts/build.js && npm run bundle",
    "test": "vitest",
    "lint": "eslint \"./src/**/*.ts\" --no-error-on-unmatched-pattern",
    "lint:fix": "eslint ./src/** --fix",
    "generate:line-break": "node ./scripts/generate-line-break-data.js"
  },
  "author": {
    "name": "Yamato Iizuka",
    "email": "me@yamatoiizuka.com"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^24.19.2",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "clean-css-cli": "^5.6.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "jsdom": "^27.0.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "webpack": "^5.112.2",
    "webpack-cli": "^6.0.1"
  }
}
